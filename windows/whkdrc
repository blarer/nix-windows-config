# whkd hotkeys — ported from modules/aerospace.nix
# Install whkd via scoop, start with: whkd
#
# Modifier parity: Darwin Alt → Windows Alt
# komorebic must be on PATH (scoop shims it)

.shell pwsh

# ─── Focus Navigation (Alt+hjkl) ──────────────────────────
alt + h : komorebic focus left
alt + j : komorebic focus down
alt + k : komorebic focus up
alt + l : komorebic focus right

# ─── Move Windows (Alt+Shift+hjkl) ────────────────────────
alt + shift + h : komorebic move left
alt + shift + j : komorebic move down
alt + shift + k : komorebic move up
alt + shift + l : komorebic move right

# ─── Workspace Switching (Alt+0-4) ────────────────────────
# komorebi workspaces are 0-indexed to match aerospace
alt + 0 : komorebic focus-workspace 0
alt + 1 : komorebic focus-workspace 1
alt + 2 : komorebic focus-workspace 2
alt + 3 : komorebic focus-workspace 3
alt + 4 : komorebic focus-workspace 4

# ─── Move Window to Workspace (Alt+Shift+0-4) ─────────────
alt + shift + 0 : komorebic move-to-workspace 0
alt + shift + 1 : komorebic move-to-workspace 1
alt + shift + 2 : komorebic move-to-workspace 2
alt + shift + 3 : komorebic move-to-workspace 3
alt + shift + 4 : komorebic move-to-workspace 4

# ─── Join-with (Alt+Shift+arrows) ─────────────────────────
# Mirrors aerospace's main-mode join-with bindings
alt + shift + left  : komorebic stack left
alt + shift + right : komorebic stack right
alt + shift + up    : komorebic stack up
alt + shift + down  : komorebic stack down

# ─── Service Mode (Alt+Shift+;) — multi-action chord ──────
# komorebi has no modal "service mode"; bind individual actions
# alt+shift+r → flatten/reset workspace tree
alt + shift + r : komorebic flatten-workspace
# alt+shift+x → close all but current (was alt+shift+backspace; whkd rejects backspace)
alt + shift + x : komorebic close-all-but-focused

# ─── Back-and-Forth (Alt+Tab) ─────────────────────────────
# komorebi lacks native back-and-forth; cycle previous workspace
alt + tab : komorebic cycle-workspace previous

# ─── Layout Toggles ───────────────────────────────────────
# Alt+/ → toggle between BSP (tiles) and Columns
alt + oem_2 : komorebic change-layout columns
# Alt+, → accordion-ish vertical stack
alt + oem_comma : komorebic change-layout rows

# ─── Float / Tile Toggle (Alt+Shift+Space) ────────────────
alt + shift + space : komorebic toggle-float

# ─── Fullscreen Toggle (Alt+F) ────────────────────────────
alt + f : komorebic toggle-maximize

# ─── Resize (Alt+Shift+=/-) ───────────────────────────────
alt + shift + oem_plus : komorebic resize-axis horizontal increase
alt + shift + oem_minus : komorebic resize-axis horizontal decrease

# ─── Open Terminal (Alt+Enter) ────────────────────────────
alt + return : wezterm-gui start

# ─── Move Workspace to Next Monitor ───────────────────────
alt + shift + tab : komorebic move-workspace-to-monitor next

# ─── Reload Config (Alt+Shift+;) ──────────────────────────
alt + shift + oem_1 : komorebic reload-configuration
