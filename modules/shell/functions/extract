if [ -z "$1" ]; then
  echo "Usage: extract <archive>"
  return 1
fi
if [ -f "$1" ]; then
  case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz)  tar xzf "$1" ;;
    *.tar.xz)  tar xJf "$1" ;;
    *.bz2)     bunzip2 "$1" ;;
    *.gz)      gunzip "$1" ;;
    *.tar)     tar xf "$1" ;;
    *.tbz2)    tar xjf "$1" ;;
    *.tgz)     tar xzf "$1" ;;
    *.zip)     unzip "$1" ;;
    *.Z)       uncompress "$1" ;;
    *.7z)      7zz x "$1" ;;
    *.rar)     unrar x "$1" ;;
    *)         echo "Unknown archive format: $1" ;;
  esac
else
  echo "File not found: $1"
fi
